SELECT COUNT(SO.CATLG_ITEM_KEY ),
COUNT(SO.PROD_OFFR_KEY),
COUNT(SO.RQ_CANCEL_TS_KEY ),
COUNT(SO.RQ_SHIP_TS_KEY ),
COUNT(SO.ORDER_STS_KEY),
COUNT(SO.EARLIEST_DLVR_TS_KEY ), 
COUNT(SO.ORIG_EXPC_DLVR_TS_KEY),
COUNT(SO.CARRIER_EXPC_DLVR_TS_KEY),
COUNT(SO.SLR_ORG_KEY),
COUNT(SO.SHIP_TO_STORE_KEY) 

FROM 
FACT_sales_order_line_IN1542 SO 
LEFT JOIN DIM_DAY_HOUR_sql_IN1542 DH ON DH.DAY_KEY=SO.RQ_CANCEL_TS_KEY 
LEFT JOIN DIM_DAY_HOUR_sql_IN1542 DH1 ON DH1.DAY_KEY=SO.RQ_SHIP_TS_KEY 
LEFT JOIN DIM_DAY_HOUR_sql_IN1542 DH2 ON DH2.DAY_KEY=SO.EARLIEST_DLVR_TS_KEY 
LEFT JOIN  DIM_DAY_HOUR_sql_IN1542 DH3 ON DH3.DAY_KEY=SO.ORIG_EXPC_DLVR_TS_KEY
LEFT JOIN  DIM_DAY_HOUR_sql_IN1542 DH4 ON DH4.DAY_KEY=SO.CARRIER_EXPC_DLVR_TS_KEY
LEFT JOIN IN1542.DIM_prod_SQL_IN1542 P    ON P.PROD_KEY=SO.CATLG_ITEM_KEY 
LEFT JOIN in1542.Dim_OFFR_SQL_IN1542  O   ON O.OFFR_KEY=SO.PROD_OFFR_KEY
LEFT JOIN IN1542.DIM_ORDER_STS_MASTER_LKP_SQL_IN1542 M ON M.ORDER_STS_MASTER_LKP_KEY=SO.ORDER_STS_KEY
LEFT JOIN IN1542.DIM_ORG_BUSINESS_UNIT_SQL_IN1542 B  ON B.ORG_BUSINESS_UNIT_KEY=SO.SLR_ORG_KEY
LEFT JOIN IN1542.DIM_cust_addr1_sql_IN1542 A  ON A.CUST_AADR1_KEY=SO.SHIP_TO_STORE_KEY

WHERE 
DH.DATE_ID  IS NULL AND 
DH.hour_id  IS NULL AND
DH1.DATE_ID	IS NULL AND
DH1.hour_id	IS NULL AND
DH2.DATE_ID IS NULL AND
DH2.hour_id	IS NULL AND
DH3.DATE_ID	IS NULL AND
DH3.hour_id	IS NULL AND
DH4.DATE_ID	IS NULL AND
DH4.hour_id	IS NULL AND
P.CATLG_ITEM_ID        IS NULL AND
O.OFFER_PK			   IS NULL AND
M.ORDER_STS_MASTER_ID  IS NULL AND
B.ORG_ID 			   IS NULL AND
A.ADDR_ID			   IS NULL
