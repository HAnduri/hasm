(
year_key int not null identity(1,1) primary key,
year_id int not null 
)

drop table dim_year

insert into dim_Year
select distinct(year(Dates)) from Dates
order by year(Dates)

select * from dim_year

create table dim_qtr
(quater_key int identity(1,1) primary key,
quater_id int not null,
year_key int not null,
year_id int not null
foreign key (year_key) references dim_year(year_key))


truncate table dim_qtr

insert into dim_qtr(quater_id,year_key,year_id)
select distinct(datename(qq,d.dates)) as quater_id,y.year_key,y.year_id
from dim_year y join dates d on y.year_key = d.year_id
order by y.year_id

create table Dim_month
(month_key int not null primary key identity(1,1),
month_id int ,
month_name varchar(20),
quater_key int not null,
quater_id int not null,
year_key int not null,
year_id int not null
foreign key (year_key) references dim_year(year_key),
foreign key (quater_key) references dim_qtr(quater_key)
);
drop table dim_month
insert into  Dim_month(month_id,month_name,quater_key,quater_id,year_key,year_id)

select distinct(month(d.dates)),
datename(month,d.dates),
q.quater_key,
q.quater_id,
q.year_key,
q.year_id
from dates d join dim_qtr q on year(d.dates) = q.year_id and datepart(qq,d.dates) = q.quater_id
order by year_id



